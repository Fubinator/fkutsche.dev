---
import "@fontsource-variable/manrope";
import "@fontsource-variable/dm-sans";
import "../styles/global.css";
import Arrow from "../components/Arrow.astro";

const capabilities = [
  {
    number: "01",
    title: "From idea to production.",
    text: "I build across the stack, connecting thoughtful interfaces with reliable backend systems and the infrastructure that runs them.",
    tags: ["TypeScript", "React", "Vue.js", "Node.js", "Go", "SQL"],
  },
  {
    number: "02",
    title: "Security from the start.",
    text: "Security-critical products shaped how I work: from authentication and end-to-end encryption to cloud infrastructure and delivery.",
    tags: ["AWS", "Terraform", "CI/CD", "ISO 27001", "BSI IT-Grundschutz"],
  },
  {
    number: "03",
    title: "Ownership beyond code.",
    text: "I stay hands-on while setting technical direction, making architecture decisions, and helping a team deliver with confidence.",
    tags: [
      "Software architecture",
      "Technical leadership",
      "Product development",
    ],
  },
];
const description =
  "Fabian Kutsche: Senior Full-Stack Engineer and Technical Lead. Building security-critical web products with TypeScript, React, Go and AWS.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5ef" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Fabian Kutsche: Engineer. Builder. Technical lead."
    />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <title>Fabian Kutsche: Senior Full-Stack Engineer & Technical Lead</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a class="wordmark" href="#" aria-label="Fabian Kutsche, home">
        fabian kutsche<span>.</span>
      </a>
      <nav aria-label="Main navigation" class="flex items-center gap-7">
        <a class="nav-link" href="#work">
          Work
        </a>
        <a class="nav-link" href="#experience">
          Experience
        </a>
        <a class="nav-contact" href="#contact">
          Let’s talk <Arrow diagonal />
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="short-line"></span> Senior Full-Stack Engineer ·
            Technical Lead
          </p>
          <h1 id="hero-title">
            Good software.
            <br />
            Built with <span class="serif">care.</span>
          </h1>
          <p class="hero-description">
            I’m Fabian. I turn complex problems into dependable web products,
            bringing together hands-on engineering, thoughtful architecture, and
            a security-first mindset.
          </p>
          <div class="hero-actions flex flex-wrap items-center gap-6">
            <a class="button" href="#work">
              Explore my work <Arrow />
            </a>
            <a class="text-link" href="/cv/fabian-kutsche-en.pdf" download>
              Download CV <span aria-hidden="true">↓</span>
            </a>
          </div>
          <p class="location">
            <svg
              width="15"
              height="18"
              viewBox="0 0 20 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <path d="M17 9c0 6-7 12-7 12S3 15 3 9a7 7 0 1 1 14 0Z" />
              <circle cx="10" cy="9" r="2.4" />
            </svg>{" "}
            Based in Horn-Bad Meinberg, Germany
          </p>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="art-top">
            <span>THE WAY I BUILD</span>
            <span>↗</span>
          </div>
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="art-axis axis-h"></div>
          <div class="art-axis axis-v"></div>
          <div class="layer layer-back">
            <span>03 / LEADERSHIP</span>
          </div>
          <div class="layer layer-middle">
            <span>02 / ARCHITECTURE</span>
          </div>
          <div class="layer layer-front">
            <span>01 / ENGINEERING</span>
            <span class="code-mark">&lt;/&gt;</span>
            <span class="layer-foot">
              Built on solid foundations.<span>↗</span>
            </span>
          </div>
          <div class="art-bottom">
            <span class="tiny-cross">+</span>
            <span>THOUGHTFUL BY DESIGN.</span>
            <span class="tiny-cross">+</span>
          </div>
        </div>
      </section>
      <section class="section wrap" aria-labelledby="approach-title">
        <div class="section-heading">
          <p class="eyebrow">01 / What I bring</p>
          <h2 id="approach-title">
            The whole picture.
            <br />
            <span class="muted">Down to the details.</span>
          </h2>
        </div>
        <div class="capabilities grid md:grid-cols-3">
          {capabilities.map((item) => (
            <article class="capability">
              <span class="item-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <ul class="tags" aria-label={`${item.title} Skills`}>
                {item.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>
      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="wrap section">
          <div class="section-heading heading-inline">
            <div>
              <p class="eyebrow">02 / Selected work</p>
              <h2 id="work-title">Built from the ground up.</h2>
            </div>
            <p>
              Two security-critical products.
              <br />
              Several hundred projects and tenants.
            </p>
          </div>
          <div class="work-grid grid md:grid-cols-2 gap-6">
            <article class="project">
              <div class="project-visual security-visual" aria-hidden="true">
                <div class="visual-label">TURINGSECURE / 01</div>
                <div class="diagram">
                  <div class="diagram-node node-top">ASSESS</div>
                  <div class="diagram-line"></div>
                  <div class="diagram-hub">
                    <svg
                      viewBox="0 0 48 48"
                      width="39"
                      height="39"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path d="m24 4 15 6v12c0 10-15 21-15 21S9 32 9 22V10Z" />
                      <path d="m17 23 5 5 10-11" />
                    </svg>
                  </div>
                  <div class="diagram-branches"></div>
                  <div class="diagram-bottom">
                    <span class="diagram-node">REPORT</span>
                    <span class="diagram-node">REMEDIATE</span>
                  </div>
                </div>
                <span class="visual-caption">
                  Application security connected to compliance
                </span>
              </div>
              <div class="project-content">
                <p class="eyebrow">Application security &amp; GRC platform</p>
                <h3>turingsecure</h3>
                <p>
                  A platform connecting penetration tests, vulnerabilities, and
                  asset management with governance, risk, and compliance. Teams
                  can prioritize findings, track remediation, and bring security
                  evidence into their audits.
                </p>
                <div class="project-detail">
                  <span>My contribution</span>
                  <p>
                    Overall architecture and hands-on development across
                    authentication, reporting, frontend, backend, and delivery
                    infrastructure.
                  </p>
                </div>
                <ul class="tags">
                  <li>Vulnerability management</li>
                  <li>Asset management</li>
                  <li>GRC</li>
                </ul>
                <a class="text-link project-link" href="https://turingsecure.com/">
                  Explore turingsecure.com <Arrow diagonal />
                </a>
              </div>
            </article>
            <article class="project">
              <div class="project-visual encryption-visual" aria-hidden="true">
                <div class="visual-label">KODADO / 02</div>
                <div class="encryption-diagram">
                  <span class="endpoint">A</span>
                  <span class="connection"></span>
                  <div class="lock">
                    <svg
                      width="34"
                      height="42"
                      viewBox="0 0 34 42"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <rect x="4" y="18" width="26" height="21" rx="3" />
                      <path d="M10 18V11a7 7 0 0 1 14 0v7" />
                      <circle cx="17" cy="28" r="2" />
                      <path d="M17 30v3" />
                    </svg>
                  </div>
                  <span class="connection"></span>
                  <span class="endpoint">B</span>
                </div>
                <div class="cipher">a7f2 · 9c4e · b813 · 6d0a · e52f</div>
                <span class="visual-caption">
                  Client-side encryption · GraphQL data access
                </span>
              </div>
              <div class="project-content">
                <p class="eyebrow">Encrypted data toolkit</p>
                <h3>Kodado</h3>
                <p>
                  A developer toolkit for storing and sharing end-to-end encrypted
                  data. Built-in authentication, a GraphQL interface, and
                  open-source TypeScript and Go SDKs let applications work with
                  data that is decrypted only on the client.
                </p>
                <div class="project-detail">
                  <span>My contribution</span>
                  <p>
                    Product architecture, core implementation, and technical
                    leadership, with ownership spanning the application and its
                    AWS infrastructure.
                  </p>
                </div>
                <ul class="tags">
                  <li>End-to-end encryption</li>
                  <li>GraphQL</li>
                  <li>TypeScript &amp; Go SDKs</li>
                </ul>
                <a class="text-link project-link" href="https://kodado.dev/">
                  Explore kodado.dev <Arrow diagonal />
                </a>
              </div>
            </article>
          </div>
          <p class="work-note">
            Selected work from my role as Head of Development. Illustrations
            show concepts, not product interfaces.
          </p>
        </div>
      </section>
      <section
        class="section wrap experience-grid"
        id="experience"
        aria-labelledby="experience-title"
      >
        <div class="experience-intro">
          <p class="eyebrow">03 / The journey</p>
          <h2 id="experience-title">
            A builder.
            <br />
            Always learning.
          </h2>
          <p>
            From an apprenticeship in software development to leading a team and
            owning products end to end.
          </p>
          <a class="text-link" href="/cv/fabian-kutsche-en.pdf" download>
            Get the full CV <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="timeline">
          <article class="timeline-item">
            <p class="timeline-date">
              JUN 2020 to OCT 2026{" "}
              <span class="current-label">Current role</span>
            </p>
            <h3>Head of Development</h3>
            <p class="company">
              turingpoint GmbH <span>· Hamburg</span>
            </p>
            <p>
              Built two security-critical web products from scratch and scaled
              them to several hundred projects and tenants. Led three developers
              while staying hands-on with architecture, code, and
              infrastructure.
            </p>
            <p>
              Also served as Information Security Officer, focusing on ISO 27001
              and BSI IT-Grundschutz.
            </p>
          </article>
          <article class="timeline-item">
            <p class="timeline-date">NOV 2017 to MAY 2020</p>
            <h3>Student Assistant · Software Development</h3>
            <p class="company">ZETCON Ingenieure GmbH</p>
            <p>
              Led development of a platform covering the lifecycle of buildings
              and structures, from inspection and maintenance to asset
              management.
            </p>
          </article>
          <article class="timeline-item">
            <p class="timeline-date">AUG 2013 to FEB 2016</p>
            <h3>Apprentice · Software Development</h3>
            <p class="company">dSPACE GmbH</p>
            <p>
              Trained as an IT specialist in application development, building a
              foundation in professional software engineering and collaborative
              delivery.
            </p>
          </article>
        </div>
      </section>
      <section class="learning wrap" aria-labelledby="learning-title">
        <div>
          <p class="eyebrow">Still curious</p>
          <h2 id="learning-title">
            Learning is part
            <br />
            of the work.
          </h2>
        </div>
        <div class="learning-detail">
          <h3>
            B.Sc. Computer Science <span>In progress</span>
          </h3>
          <p>
            FernUniversität in Hagen · Since October 2022
            <br />
            Part-time alongside full-time work · Expected October 2026
          </p>
          <p>
            Focusing on artificial intelligence, deep learning, and
            self-supervised learning. My thesis explores ranking functions in
            abstract argumentation.
          </p>
          <p class="earlier-study">
            Previously: Computer Science at TU Dortmund, 2016–2020 (without
            degree).
          </p>
          <div class="certifications">
            <div>
              <span class="cert-icon" aria-hidden="true">
                ↗
              </span>
              <p>
                <strong>iSAQB CPSA-F</strong>
                <span>Software Architecture · Exam passed September 2026</span>
              </p>
            </div>
            <div>
              <span class="cert-icon" aria-hidden="true">
                ↗
              </span>
              <p>
                <strong>Information Security Foundation</strong>
                <span>ISO/IEC 27001 · TÜV SÜD Akademie · September 2021</span>
              </p>
            </div>
          </div>
        </div>
      </section>
      <section
        class="contact-section wrap"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="contact-top">
          <span>Let’s make the next chapter a good one.</span>
        </div>
        <h2 id="contact-title">
          Good things start
          <br />
          with a <span class="serif">conversation.</span>
        </h2>
        <div class="contact-bottom">
          <a class="contact-email" href="mailto:kutschefabian@gmail.com">
            kutschefabian@gmail.com <Arrow diagonal />
          </a>
          <p>
            Senior Full-Stack Engineer · Technical Lead
            <br />
            German native · Fluent in English
          </p>
        </div>
      </section>
    </main>
    <footer class="wrap site-footer">
      <a class="wordmark" href="#">
        fk<span>.</span>
      </a>
      <p>© {new Date().getFullYear()} Fabian Kutsche</p>
      <nav aria-label="Social links and CV downloads">
        <a href="https://github.com/Fubinator">
          GitHub <Arrow diagonal />
        </a>
        <a href="https://www.linkedin.com/in/fabian-kutsche-9a77261ab/">
          LinkedIn <Arrow diagonal />
        </a>
        <a href="/cv/fabian-kutsche-en.pdf" download>
          CV / EN ↓
        </a>
        <a href="/cv/fabian-kutsche-de.pdf" download lang="de">
          CV / DE ↓
        </a>
      </nav>
    </footer>
  </body>
</html>
