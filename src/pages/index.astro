---
import "@fontsource-variable/dm-sans";
import "../styles/global.css";
import Arrow from "../components/Arrow.astro";
import { Image } from "astro:assets";
import portrait from "../assets/fabian-kutsche.png";

const description =
  "Fabian Kutsche: Senior Full-Stack Engineer and Technical Lead. Building security-critical web products with TypeScript, React, Go and AWS.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1eb" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Fabian Kutsche — Software Engineer & Technical Lead"
    />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <title>Fabian Kutsche: Senior Full-Stack Engineer & Technical Lead</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a class="wordmark" href="#" aria-label="Fabian Kutsche, home">
        Fabian Kutsche<span class="wordmark-role">Software engineer</span>
      </a>
      <nav aria-label="Main navigation" class="main-nav">
        <a class="nav-link" href="#work">
          Work
        </a>
        <a class="nav-link" href="#experience">
          Experience
        </a>
        <a class="nav-contact" href="#contact">
          Let’s talk <Arrow diagonal />
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="profile">
          <div class="portrait">
            <Image
              src={portrait}
              alt="Fabian Kutsche"
              widths={[180, 360, 540]}
              sizes="(max-width: 700px) 88px, 180px"
              format="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="profile-caption">
            <p>Fabian Kutsche</p>
            <span>Horn-Bad Meinberg, Germany</span>
          </div>
        </div>
        <div class="hero-copy">
          <p class="eyebrow">Full-stack software engineer</p>
          <h1 id="hero-title">I build dependable<br />web products.</h1>
          <p class="hero-description">
            I’m Fabian, a software engineer with a background in security-critical
            products. I work across the stack, from the first architecture decisions
            to the code and infrastructure that run in production.
          </p>
          <div class="hero-actions">
            <a class="button" href="#work">Explore my work <Arrow /></a>
            <a class="text-link" href="/cv/fabian-kutsche-en.pdf" download>
              Download CV <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </section>

      <section class="work-section wrap" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <h2 id="work-title">Selected work</h2>
          <p>Built from scratch at turingpoint.</p>
        </div>
        <article class="project">
          <div class="project-heading">
            <span class="project-category">Security &amp; compliance</span>
            <h3><a href="https://turingsecure.com/">turingsecure <Arrow diagonal /></a></h3>
            <p>Application security &amp; GRC platform</p>
          </div>
          <div class="project-content">
            <p>A platform connecting penetration tests, vulnerabilities, and asset
              management with governance, risk, and compliance. Teams can prioritize
              findings, track remediation, and bring security evidence into their audits.</p>
            <div class="project-detail">
              <h4>My role</h4>
              <p>Overall architecture and hands-on development across authentication,
                reporting, frontend, backend, and delivery infrastructure.</p>
            </div>
            <ul class="project-topics" aria-label="turingsecure focus areas">
              <li>Vulnerability management</li><li>Asset management</li><li>GRC</li>
            </ul>
          </div>
        </article>
        <article class="project">
          <div class="project-heading">
            <span class="project-category">Encryption &amp; developer tools</span>
            <h3><a href="https://kodado.dev/">Kodado <Arrow diagonal /></a></h3>
            <p>End-to-end encrypted data toolkit</p>
          </div>
          <div class="project-content">
            <p>A developer toolkit for storing and sharing end-to-end encrypted data.
              Built-in authentication, a GraphQL interface, and open-source TypeScript
              and Go SDKs let applications work with data decrypted only on the client.</p>
            <div class="project-detail">
              <h4>My role</h4>
              <p>Product architecture, core implementation, and technical leadership,
                with ownership spanning the application and its AWS infrastructure.</p>
            </div>
            <ul class="project-topics" aria-label="Kodado focus areas">
              <li>End-to-end encryption</li><li>GraphQL</li><li>TypeScript &amp; Go SDKs</li>
            </ul>
          </div>
        </article>
        <p class="work-note">Together, these products grew to several hundred projects and tenants.</p>
      </section>

      <section class="practice-section" aria-labelledby="practice-title">
        <div class="wrap practice-grid">
          <div class="section-intro">
            <h2 id="practice-title">How I work</h2>
            <p>I stay close to the code, even when my responsibility goes beyond it.</p>
          </div>
          <div class="practice-list">
            <div class="practice-item">
              <h3>Across the stack</h3>
              <p>Interfaces, backend systems, and the infrastructure that connects them.</p>
              <p class="skill-list">TypeScript / React / Vue.js / Node.js / Go / SQL</p>
            </div>
            <div class="practice-item">
              <h3>Security in the details</h3>
              <p>Authentication, encryption, and delivery shaped by work on security-critical products.</p>
              <p class="skill-list">AWS / Terraform / CI/CD / ISO 27001 / BSI IT-Grundschutz</p>
            </div>
            <div class="practice-item">
              <h3>Shared responsibility</h3>
              <p>Setting technical direction, making architecture decisions, and helping a team deliver.</p>
              <p class="skill-list">Software architecture / Technical leadership / Product development</p>
            </div>
          </div>
        </div>
      </section>
      <section
        class="section wrap experience-grid"
        id="experience"
        aria-labelledby="experience-title"
      >
        <div class="experience-intro">
          <h2 id="experience-title">Experience</h2>
          <p>
            From an apprenticeship in software development to leading a team and
            owning products end to end.
          </p>
          <a class="text-link" href="/cv/fabian-kutsche-en.pdf" download>
            Get the full CV <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="timeline">
          <article class="timeline-item">
            <p class="timeline-date">
              JUN 2020 to OCT 2026{" "}
              <span class="current-label">Current role</span>
            </p>
            <h3>Head of Development</h3>
            <p class="company">
              turingpoint GmbH <span>· Hamburg</span>
            </p>
            <p>
              Built two security-critical web products from scratch and scaled
              them to several hundred projects and tenants. Led three developers
              while staying hands-on with architecture, code, and
              infrastructure.
            </p>
            <p>
              Also served as Information Security Officer, focusing on ISO 27001
              and BSI IT-Grundschutz.
            </p>
          </article>
          <article class="timeline-item">
            <p class="timeline-date">NOV 2017 to MAY 2020</p>
            <h3>Student Assistant · Software Development</h3>
            <p class="company">ZETCON Ingenieure GmbH</p>
            <p>
              Led development of a platform covering the lifecycle of buildings
              and structures, from inspection and maintenance to asset
              management.
            </p>
          </article>
          <article class="timeline-item">
            <p class="timeline-date">AUG 2013 to FEB 2016</p>
            <h3>Apprentice · Software Development</h3>
            <p class="company">dSPACE GmbH</p>
            <p>
              Trained as an IT specialist in application development, building a
              foundation in professional software engineering and collaborative
              delivery.
            </p>
          </article>
        </div>
      </section>
      <section class="learning wrap" aria-labelledby="learning-title">
        <div>
          <h2 id="learning-title">Education &amp;<br /> qualifications</h2>
        </div>
        <div class="learning-detail">
          <h3>
            B.Sc. Computer Science <span>In progress</span>
          </h3>
          <p>
            FernUniversität in Hagen · Since October 2022
            <br />
            Part-time alongside full-time work · Expected October 2026
          </p>
          <p>
            Focusing on artificial intelligence, deep learning, and
            self-supervised learning. My thesis explores ranking functions in
            abstract argumentation.
          </p>
          <p class="earlier-study">
            Previously: Computer Science at TU Dortmund, 2016–2020 (without
            degree).
          </p>
          <div class="certifications">
            <div>
              <span class="cert-icon" aria-hidden="true">
                ↗
              </span>
              <p>
                <strong>iSAQB CPSA-F</strong>
                <span>Software Architecture · Exam passed September 2026</span>
              </p>
            </div>
            <div>
              <span class="cert-icon" aria-hidden="true">
                ↗
              </span>
              <p>
                <strong>Information Security Foundation</strong>
                <span>ISO/IEC 27001 · TÜV SÜD Akademie · September 2021</span>
              </p>
            </div>
          </div>
        </div>
      </section>
      <section
        class="contact-section wrap"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="contact-intro">
          <p class="eyebrow">Get in touch</p>
          <h2 id="contact-title">Let’s talk.</h2>
          <p>About a product, a role, or a technical challenge.</p>
        </div>
        <div class="contact-details">
          <a class="contact-email" href="mailto:kutschefabian@gmail.com">
            kutschefabian@gmail.com <Arrow diagonal />
          </a>
          <p>German native · Fluent in English</p>
        </div>
      </section>
    </main>
    <footer class="wrap site-footer">
      <a class="wordmark" href="#">
        FK
      </a>
      <p>© {new Date().getFullYear()} Fabian Kutsche</p>
      <nav aria-label="Social links and CV downloads">
        <a href="https://github.com/Fubinator">
          GitHub <Arrow diagonal />
        </a>
        <a href="https://www.linkedin.com/in/fabian-kutsche-9a77261ab/">
          LinkedIn <Arrow diagonal />
        </a>
        <a href="/cv/fabian-kutsche-en.pdf" download>
          CV / EN ↓
        </a>
        <a href="/cv/fabian-kutsche-de.pdf" download lang="de">
          CV / DE ↓
        </a>
      </nav>
    </footer>
  </body>
</html>
